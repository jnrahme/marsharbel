  "verifier_unit_duplicate_removed": "python3 -m unittest discover -s scripts/qa -p 'test_verify_deployment.py'",
  "verifier_unit_retained_job": "qa-gates",
  "qa_gates_commands": [
    {
      "name": "Test deployment verification",
      "run": "python3 -m unittest discover -s scripts/qa -p 'test_verify_deployment.py'",
      "if": null
    },
    {
      "name": "Install dependencies",
      "run": "npm ci",
      "if": null
    },
    {
      "name": "Install Playwright browser",
      "run": "npx playwright install --with-deps chromium",
      "if": "steps.pw-cache.outputs.cache-hit != 'true'"
    },
    {
      "name": "Install Playwright system dependencies (browser cache hit)",
      "run": "npx playwright install-deps chromium",
      "if": "steps.pw-cache.outputs.cache-hit == 'true'"
    },
    {
      "name": "Install Python dependencies",
      "run": "pip install beautifulsoup4",
      "if": null
    },
    {
      "name": "New-page locale key gate tests",
      "run": "python3 -m unittest discover -s scripts/qa -p 'test_new_page_locales.py'",
      "if": null
    },
    {
      "name": "New-page locale key coverage (PR base)",
      "run": "python3 scripts/qa/check_new_page_locales.py --base \"$LOCALE_GATE_BASE\"",
      "if": "github.event_name == 'pull_request'"
    },
    {
      "name": "Russian first-slice publication and browser guards",
      "run": "python3 -m unittest discover -s scripts/qa -p 'test_russian_slice.py'\nnpx playwright test tests/russian-first-slice.spec.js --project=small-phone --project=phone --project=laptop --workers=2\n",
      "if": null
    },
    {
      "name": "Clean-checkout page build is in sync",
      "run": "node scripts/build-pages.mjs --check",
      "if": null
    }
  ],
  "qa_aggregate_needs": [
    "qa-shard",
    "qa-gates",
