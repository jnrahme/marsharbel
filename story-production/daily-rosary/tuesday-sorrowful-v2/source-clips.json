    "true_peak_dbtp": -2.51,
    "sha256": "81909b8a6720ac191ea4d0136993ef81e5c9e22e4e9807f1f9acba658a105bc5",
    "script": "Jesus is brought before Pilate, questioned, and rejected by the crowd. Though innocent, He is handed over and scourged. The scene shows injustice, violence, and Christ's silent endurance for the salvation of souls.\n\nThe Scourging reveals Christ's innocent suffering and the cost of human sin.\n\nStay with this mystery as you pray.",
    "script_sha256": "4344aa7a513d2017cf19b246f2a6c258f141179d7b4a4d9c9ba6fea27323bd61",
    "source_scripture": "John 18:28-40; 19:1",
    "key": "sorrowful_2",
