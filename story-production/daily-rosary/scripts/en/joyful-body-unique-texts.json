[
  {
    "key": "joyful-announcement",
    "kind": "announcement",
    "text": "Today we pray the Joyful Mysteries.",
    "text_sha256": "9d9e2032a3cd4731215fa182b0cd3109902d30bfa8b88bfd73abefa9107aef7d"
  },
  {
    "key": "joyful_1-announcement",
    "kind": "mystery_announcement",
    "text": "First Joyful Mystery. The Annunciation.",
    "text_sha256": "66e7007a42f14005124389b0d238d6c97e8eade2c6d9d74973b97a1e47ac1122"
  },
  {
    "key": "joyful_1-intro",
    "kind": "mystery_intro",
    "text": "Picture the angel Gabriel coming to Mary in Nazareth. He tells her that she will bear Jesus, the Son of the Most High. Mary freely accepts God's call.",
    "source_scripture": "Luke 1:26-38",
    "claim_type": "Gospel paraphrase/devotional visualization;not quotation",
    "text_sha256": "76e20702dfbbb0f102dd6af726ddb7ec0ddc8ad3f39b387fd209a52e20e9083a"
  },
  {
    "key": "joyful_1-bead-1",
    "kind": "meditation",
    "text": "Picture Nazareth at dawn, with a quiet, simple room.",
    "source_scripture": "Luke 1:26-38",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "0cee6f7c0c4f062b948ec499584fd2140a516d198615b47355a12b3912b569a8"
  },
  {
    "key": "joyful_1-bead-2",
    "kind": "meditation",
    "text": "Picture Mary at prayer, listening with a peaceful heart.",
    "source_scripture": "Luke 1:26-38",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "17c9af115908c382dfb6c61e6ce90adbd073ad8f519c1fa8deb497f42a27ee74"
  },
  {
    "key": "joyful_1-bead-3",
    "kind": "meditation",
    "text": "Picture Gabriel arriving before Mary with a message from God.",
    "source_scripture": "Luke 1:26-38",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "e74d2366f09fe5dd5708aa3f0bc9726458584532dc0407ae01e3e99ff6e488e0"
  },
  {
    "key": "joyful_1-bead-4",
    "kind": "meditation",
    "text": "Picture Mary listening as Gabriel tells her she will bear the Savior.",
    "source_scripture": "Luke 1:26-38",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "3c1415d1dbc4a623d1b1dcb7061f2ce13707c78e5437eea51fafa526c4a0c593"
  },
  {
    "key": "joyful_1-bead-5",
    "kind": "meditation",
    "text": "Picture Mary pausing in wonder and asking how this will happen.",
    "source_scripture": "Luke 1:26-38",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "cea4d52fc2f1afd514fc928f69288615fc19623daa5683511c99e1fbf5722f00"
  },
  {
    "key": "joyful_1-bead-6",
    "kind": "meditation",
    "text": "Picture the Holy Spirit overshadowing Mary.",
    "source_scripture": "Luke 1:26-38",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "4f0bcfde2945995282c4b9115764829f3084380c80ff6a82048c053b661088d1"
  },
  {
    "key": "joyful_1-bead-7",
    "kind": "meditation",
    "text": "Picture Mary freely preparing to say yes to God.",
    "source_scripture": "Luke 1:26-38",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "35cb0566302abec67444bdc517dede0465000a10577259decaab5b83956bfc42"
  },
  {
    "key": "joyful_1-bead-8",
    "kind": "meditation",
    "text": "Picture Mary freely accepting God's call to become the mother of Jesus.",
    "source_scripture": "Luke 1:26-38",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "daea6f6abb1e84d86284fa36c2ccd24b89f931e592712f76865b0976f935cf61"
  },
  {
    "key": "joyful_1-bead-9",
    "kind": "meditation",
    "text": "Picture the Son of God becoming a child in Mary's womb.",
    "source_scripture": "Luke 1:26-38",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "485ae2342453a0dc6000653eeaf043f2ff11241cf0700e3943108f45280b5aed"
  },
  {
    "key": "joyful_1-bead-10",
    "kind": "meditation",
    "text": "Picture Mary remaining in the quiet room after the angel leaves.",
    "source_scripture": "Luke 1:26-38",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "3fb2078a16a11668edc0156c68a47b8bf9c2782bacb67112780abcb9a633c398"
  },
  {
    "key": "joyful_2-announcement",
    "kind": "mystery_announcement",
    "text": "Second Joyful Mystery. The Visitation.",
    "text_sha256": "ef9e2083c1d0f8fc970ecf75c22a0c742a7a401a877c401effa6979e91aeb16b",
    "source_scripture": "Luke 1:39-56"
  },
  {
    "key": "joyful_2-intro",
    "kind": "mystery_intro",
    "text": "Picture Mary visiting Elizabeth. Elizabeth rejoices, and the child in her womb leaps for joy. Mary praises God for his mercy.",
    "source_scripture": "Luke 1:39-56",
    "claim_type": "Gospel paraphrase/devotional visualization;not quotation",
    "text_sha256": "5d6db1373f5be65dd1f35ad6db4dc4552cb8658b4f2ff2bce6ce468f6bbbb0aa"
  },
  {
    "key": "joyful_2-bead-1",
    "kind": "meditation",
    "text": "Picture Mary setting out from Nazareth to visit Elizabeth.",
    "source_scripture": "Luke 1:39-56",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "0fbeba87b0deef97666d5f5b05b1549efa9f06d815826d23dbc4667a9af9f58f"
  },
  {
    "key": "joyful_2-bead-2",
    "kind": "meditation",
    "text": "Picture Mary traveling through the hills toward Elizabeth's home.",
    "source_scripture": "Luke 1:39-56",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "6465c68d691243ff37c0f265090b3161774f7fa36b34d3c33f633e3c5488eb1e"
  },
  {
    "key": "joyful_2-bead-3",
    "kind": "meditation",
    "text": "Picture Mary entering the house and greeting Elizabeth.",
    "source_scripture": "Luke 1:39-56",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "1669dfddab7ac84d3fef31b21af14e0a35599030c4ab9f265653fc9e5b18a825"
  },
  {
    "key": "joyful_2-bead-4",
    "kind": "meditation",
    "text": "Picture John leaping in Elizabeth's womb at Mary's greeting.",
    "source_scripture": "Luke 1:39-56",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "52096d094a4289713738768cdf1f529df1c06d41e10703a3140fa6a977d911e9"
  },
  {
    "key": "joyful_2-bead-5",
    "kind": "meditation",
    "text": "Picture Elizabeth welcoming Mary and blessing the child she carries.",
    "source_scripture": "Luke 1:39-56",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "daa55d1209ecc88186f92105105ef66239f871548dbbcef3d5edf4a529a67b29"
  },
  {
    "key": "joyful_2-bead-6",
    "kind": "meditation",
    "text": "Picture Mary praising God in the Magnificat.",
    "source_scripture": "Luke 1:39-56",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "a674f29ca0281df6251cc7f8e17ec3ea3f6a1914edcfebf2142b12aff8c92c5f"
  },
  {
    "key": "joyful_2-bead-7",
    "kind": "meditation",
    "text": "Picture Mary staying beside Elizabeth through the months of waiting.",
    "source_scripture": "Luke 1:39-56",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "b358905fa348393458008bd14701898d0285ce2c2ccb20d7ef8953532fed296d"
  },
  {
    "key": "joyful_2-bead-8",
    "kind": "meditation",
    "text": "Picture Mary helping with the ordinary work of the household.",
    "source_scripture": "Luke 1:39-56",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "1ef9cb3947b8bec0c0c277e2ce782c59bf3361b541de13711a190b097be20846"
  },
  {
    "key": "joyful_2-bead-9",
    "kind": "meditation",
    "text": "Picture the two mothers sharing the quiet moments of the day.",
    "source_scripture": "Luke 1:39-56",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "c9b52228a21d9425a13bdfc810833c743a73a6bf14eb9e17a72af9951de2b44e"
  },
  {
    "key": "joyful_2-bead-10",
    "kind": "meditation",
    "text": "Picture Mary returning home after her visit.",
    "source_scripture": "Luke 1:39-56",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "899b850d738f0f3028f3aae40f8114bb051201689178700c12ae77db440e133b"
  },
  {
    "key": "joyful_3-announcement",
    "kind": "mystery_announcement",
    "text": "Third Joyful Mystery. The Nativity.",
    "text_sha256": "9d75565d86b5deab47a58395eb84f2395aea5de6334cca6a4cdd81909afc56ed",
    "source_scripture": "Luke 2:1-20"
  },
  {
    "key": "joyful_3-intro",
    "kind": "mystery_intro",
    "text": "Picture Mary and Joseph in Bethlehem. Jesus is born and laid in a manger. Shepherds hear the angels' good news and come to find him.",
    "source_scripture": "Luke 2:1-20",
    "claim_type": "Gospel paraphrase/devotional visualization;not quotation",
    "text_sha256": "cc8c38889ce7006791e95b6af4550078feb457d93c13c8f9984d081f8f4a9834"
  },
  {
    "key": "joyful_3-bead-1",
    "kind": "meditation",
    "text": "Picture Mary and Joseph arriving in Bethlehem.",
    "source_scripture": "Luke 2:1-20",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "e59ac758933a48d66aa63bb3b88ea00efee01454a7d3a94a81ae2ba8b5d9be9f"
  },
  {
    "key": "joyful_3-bead-2",
    "kind": "meditation",
    "text": "Picture Mary and Joseph finding no place in the lodging.",
    "source_scripture": "Luke 2:1-20",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "43fc4dd4d11d569b0e19c876d56155b722fba1983f8d8a8b37f1eecf1399835c"
  },
  {
    "key": "joyful_3-bead-3",
    "kind": "meditation",
    "text": "Picture the humble place where Mary will give birth.",
    "source_scripture": "Luke 2:1-20",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "29d3b96ba0602ddcf0b65b4d136fa6b8efcfd4dbc142cbc8e043454a51518646"
  },
  {
    "key": "joyful_3-bead-4",
    "kind": "meditation",
    "text": "Picture the newborn Jesus wrapped in swaddling clothes.",
    "source_scripture": "Luke 2:1-20",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "45d2a5a98c2d1b0b73836c8e2dbfd1e9ecf9164ea23d4fa2665f021fe2ba20ce"
  },
  {
    "key": "joyful_3-bead-5",
    "kind": "meditation",
    "text": "Picture Mary laying Jesus gently in a manger.",
    "source_scripture": "Luke 2:1-20",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "74f3e3916b923ff3f36398f7fec44eff2cd5709510001f4b7fa03482b3ebe122"
  },
  {
    "key": "joyful_3-bead-6",
    "kind": "meditation",
    "text": "Picture shepherds outside at night, hearing the angel's announcement.",
    "source_scripture": "Luke 2:1-20",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "4b5881868279c487fdca3dd9aed42c994a4871b67e9143184818ab7fa4b2d20e"
  },
  {
    "key": "joyful_3-bead-7",
    "kind": "meditation",
    "text": "Picture the shepherds coming to see the child.",
    "source_scripture": "Luke 2:1-20",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "5b4b69c2c1bfc3d9be9227371d0079dba0bdb2a9a5fe9b179b59f474d2114e54"
  },
  {
    "key": "joyful_3-bead-8",
    "kind": "meditation",
    "text": "Picture Mary and Joseph welcoming the shepherds beside the manger.",
    "source_scripture": "Luke 2:1-20",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "6076eb311e417dbf7ce5e58412145283c8cc14eb1acd33daacbe8a8acc655882"
  },
  {
    "key": "joyful_3-bead-9",
    "kind": "meditation",
    "text": "Picture the shepherds kneeling before the child.",
    "source_scripture": "Luke 2:1-20",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "b7ead898f73b0b3ef7d24bbdd86759705f375dc2f5963c08f3577b92613411f9"
  },
  {
    "key": "joyful_3-bead-10",
    "kind": "meditation",
    "text": "Picture Mary keeping these events in her heart.",
    "source_scripture": "Luke 2:1-20",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "8caae232f754b7fb4acb395a9808545ef179e16278d2f48a1733d9feb8a886d4"
  },
  {
    "key": "joyful_4-announcement",
    "kind": "mystery_announcement",
    "text": "Fourth Joyful Mystery. The Presentation.",
    "text_sha256": "d87f237fc80c9d2fe86e5b2a88dabc7be33e3a148f6e7c179ae16bbfc0449a46"
  },
  {
    "key": "joyful_4-intro",
    "kind": "mystery_intro",
    "text": "Picture Mary and Joseph bringing Jesus to the Temple. Simeon receives the child and praises God. Anna gives thanks and speaks about him to those awaiting redemption.",
    "source_scripture": "Luke 2:22-38",
    "claim_type": "Gospel paraphrase/devotional visualization;not quotation",
    "text_sha256": "66a4dbeb520e3322e7b033c3a7d7358b159642a0f9a67ad7f3dc795c8b3f970d"
  },
  {
    "key": "joyful_4-bead-1",
    "kind": "meditation",
    "text": "Picture Mary and Joseph bringing Jesus into the Temple.",
    "source_scripture": "Luke 2:22-38",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "9659536786356c8b808f65cf14a5b184017c49a92375402ede43ad175b9f9834"
  },
  {
    "key": "joyful_4-bead-2",
    "kind": "meditation",
    "text": "Picture Mary and Joseph making their humble offering.",
    "source_scripture": "Luke 2:22-38",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "7eb30259d9bce8d1c9c3a07a751272d0185fd2436158dc9b8f7b6ed079bb94d3"
  },
  {
    "key": "joyful_4-bead-3",
    "kind": "meditation",
    "text": "Picture Simeon taking the child into his arms.",
    "source_scripture": "Luke 2:22-38",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "05a96df2357d90f136e9968cc4de8ef004ccd158d7945707ba793df8234a84d5"
  },
  {
    "key": "joyful_4-bead-4",
    "kind": "meditation",
    "text": "Picture Simeon praising God for the salvation he has waited to see.",
    "source_scripture": "Luke 2:22-38",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "627bb6e9ddebacb9958534c8cd783057c0f528746b91ab4c1e5a9d760611de2c"
  },
  {
    "key": "joyful_4-bead-5",
    "kind": "meditation",
    "text": "Picture Mary listening as Simeon speaks of the sorrow ahead.",
    "source_scripture": "Luke 2:22-38",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "f55f64bae8869a09a93f3c085af1e5cf1991515c97798aa732779bfa93c43610"
  },
  {
    "key": "joyful_4-bead-6",
    "kind": "meditation",
    "text": "Picture Mary holding Jesus close as she receives Simeon's words.",
    "source_scripture": "Luke 2:22-38",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "344c50ed0351c58da4cc9f5dae345bd1172949c033d3e68ecc7b5c654cfd4a5d"
  },
  {
    "key": "joyful_4-bead-7",
    "kind": "meditation",
    "text": "Picture Anna giving thanks and speaking about the child.",
    "source_scripture": "Luke 2:22-38",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "42f94709e7fcdd55c543d95ee78156fcef7617a4bed73ef83e8138adcff9b9d8"
  },
  {
    "key": "joyful_4-bead-8",
    "kind": "meditation",
    "text": "Picture the family standing together in the Temple.",
    "source_scripture": "Luke 2:22-38",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "a6bcb423f8f01b3c64da9014415c83704eedcd309210eb942541674b0c90e589"
  },
  {
    "key": "joyful_4-bead-9",
    "kind": "meditation",
    "text": "Picture Mary and Joseph leaving the Temple with Jesus.",
    "source_scripture": "Luke 2:22-38",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "03944e20590b810908ab5f2d4b898b1b157e0cd835700f4e4ab409f152e6f092"
  },
  {
    "key": "joyful_4-bead-10",
    "kind": "meditation",
    "text": "Picture the family returning to their ordinary life in Nazareth.",
    "source_scripture": "Luke 2:22-38",
    "source_manifest": "https://marsharbel.com/media/rosary-rebuild/manifest.json",
    "claim_type": "authored devotional visualization;not quotation",
    "text_sha256": "c551cd0df0fb5c526d020610437302948ea2e9c17e37e45b90537292026b0eb9"
  },
  {
    "key": "joyful_5-announcement",
    "kind": "mystery_announcement",
    "text": "Fifth Joyful Mystery. Finding Jesus in the Temple.",
    "text_sha256": "24808c451ff3885f04ae79faf11cc600db775c2f0db679928cfd0ab3f85ecd8f"
  },
  {
    "key": "joyful_5-intro",
    "kind": "mystery_intro",
    "text": "Picture Mary and Joseph searching for Jesus in Jerusalem. After three days they find him in the Temple, listening and asking questions. He returns with them to Nazareth.",
    "source_scripture": "Luke 2:40-51",
    "claim_type": "Gospel paraphrase/devotional visualization;not quotation",
    "text_sha256": "fddecc1a30b41ba8557c8c53f9fa0f6466ff26f6b07f725b3004d0d8818a16ff"
