    "sha256": "698da6bccabf804dfe7aa7aa11d7d6a33ac1998f5440fdc5f0c77c989a80e409",
    "text": "That we may be made worthy of the promises of Christ.",
    "text_sha256": "67c7db160905e57f7d9f0db4dacce7d8bbf776a9b685a0964726c102fd12b42f"
  },
