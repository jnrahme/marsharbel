    "sha256": "064bc10fd3942a8b1fbaa87e11a718ad529874e8be566ea7e78d6966b0dd435e",
    "text": "Pray for us, O holy Mother of God.",
    "text_sha256": "ca1ead6378ebf319e27141713cee745b69bd60f35220849c1439d79d91e6d7ee"
  },
  {
    "key": "dialogue_r",
    "kind": "dialogue_r",
    "section": 6,
    "start": 2042.6400000000017,
    "duration": 3.6,
    "bead": 0,
