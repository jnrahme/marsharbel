    "sha256": "5ead9789dc9e7f597a38c0cbb7956fa8967e8c5b7287e12fd18e462f13843f52",
    "text": "Picture the dusty road toward Calvary and the crowd around Him.",
    "text_sha256": "7cd00e17aa8ace516a551dadc372cbdb7cddcbb82c575bc78def4034b06d4298"
  },
  {
