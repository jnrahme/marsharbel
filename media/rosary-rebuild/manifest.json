          "true_peak_dbtp": -2.04,
          "sha256": "421f77a1f98934bafaa3ed47724e44557d3ed33747fce5dffc8d81d733afece6",
          "script": "Picture Mary pausing in wonder and asking how this will happen.",
          "script_sha256": "0d8f4e9ca03be379a8602a8c0ffa468b18b82d98936addbb4f8e661a83b9890a"
        },
        "step-08": {
