          "true_peak_dbtp": -1.96,
          "sha256": "844fd4b128ac206687a295233dcde5c2d0ae3dc96a8d81beefc3935367f1265b",
          "script": "Picture Mary answering, \"Let it be done to me according to your word.\"",
          "script_sha256": "09e7135994e6122755e4b1e5ee23b61e0e94955232cb0489a16e1fd17b146398"
        },
        "step-11": {
          "path": "/media/rosary-rebuild/joyful_1/step-11.mp3",
          "clip_title": "Visualization 9",
          "duration_sec": 4.466939,
