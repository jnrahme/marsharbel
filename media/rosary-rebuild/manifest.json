  "mysteries": {
    "joyful_1": {
      "decade_title": "The Annunciation",
      "status": "live",
      "steps": {
        "step-01": {
          "path": "/media/rosary-rebuild/joyful_1/step-01.mp3",
          "clip_title": "Opening",
          "duration_sec": 32.679184,
          "integrated_lufs": -17.13,
          "true_peak_dbtp": -2.05,
          "sha256": "85260d16e755bc2f13857df7d9b1dabbc29e88eefe1bcbd3824936acd3c79d60",
          "script": "The angel Gabriel is sent to Nazareth and greets Mary: \"Hail, full of grace.\" Mary is troubled, then listens. Gabriel reveals that she will conceive by the Holy Spirit and bear Jesus, Son of the Most High. Mary responds: \"Behold, I am the handmaid of the Lord. Let it be done to me according to your word.\"\n\nThe Annunciation is the moment of Mary's free yes. God does not force grace; He invites. The Word takes flesh through humility and trust.\n\nStay with this mystery as you pray.",
          "script_sha256": "38aceecf5323754b3efa047880f861d116ec268223c37bb23c997069ac3c85c0"
        },
        "step-02": {
          "path": "/media/rosary-rebuild/joyful_1/step-02.mp3",
          "clip_title": "Meaning and intention before Our Father",
          "duration_sec": 8.306939,
          "integrated_lufs": -17.24,
          "true_peak_dbtp": -2.1,
          "sha256": "70eb730a5d4d2fd819b24577d6bc8f21d23f5724e0763d4573942976ec17323e",
          "script": "Mary freely says yes to God. Set your intention on receiving His will with humility.\nPray one Our Father.",
          "script_sha256": "b5aae816a22e9587cfe3b8bc356e6e97e641559d3840818affdeaecad57988bc"
        },
        "step-03": {
          "path": "/media/rosary-rebuild/joyful_1/step-03.mp3",
          "clip_title": "Visualization 1",
          "duration_sec": 4.075102,
          "integrated_lufs": -17.23,
          "true_peak_dbtp": -2.09,
          "sha256": "e5982acfdf149c159a71d63b9328b6c2c0060a08502670826a2dda700efba7ca",
          "script": "Picture Nazareth at dawn, with a quiet, simple room.",
          "script_sha256": "fe418d20f7e63e41aaacb3ef44e60dc1cfce4b2486f82760c64df6125822d4f1"
        },
        "step-04": {
          "path": "/media/rosary-rebuild/joyful_1/step-04.mp3",
          "clip_title": "Visualization 2",
          "duration_sec": 4.153469,
          "integrated_lufs": -17.19,
          "true_peak_dbtp": -2.05,
          "sha256": "a656d15c3c2ec9d8ff82f0ef531d018f9a8123076630fe2a0862424dd6ae4e17",
          "script": "Picture Mary at prayer, listening with a peaceful heart.",
          "script_sha256": "71d414a721826727874a0a26a21266aa817fe3c09dba174f6951300b0da6f3d6"
        },
        "step-05": {
          "path": "/media/rosary-rebuild/joyful_1/step-05.mp3",
          "clip_title": "Visualization 3",
          "duration_sec": 4.806531,
          "integrated_lufs": -17.01,
          "true_peak_dbtp": -2.15,
          "sha256": "eb0db5abf52b36b89d55b41d68a5f5876afa764b531bae7a9beaff7932573829",
          "script": "Picture Gabriel arriving before Mary with a message from God.",
          "script_sha256": "9d6582a499fd398c89581adcd3bd5ee9b893880c513d7a2f7b9d028147263520"
        },
        "step-06": {
          "path": "/media/rosary-rebuild/joyful_1/step-06.mp3",
          "clip_title": "Visualization 4",
          "duration_sec": 5.198367,
          "integrated_lufs": -17.21,
          "true_peak_dbtp": -2.15,
          "sha256": "b4bab27d9d4c7dc9bb5ec9718ba93583a839543249d73931b369489799959e06",
          "script": "Picture Mary listening as Gabriel tells her she will bear the Savior.",
          "script_sha256": "6e8c4aadc117ba893915afb1780ed050fba0a53ffb1eca39b350927c22b1b426"
        },
        "step-07": {
          "path": "/media/rosary-rebuild/joyful_1/step-07.mp3",
          "clip_title": "Visualization 5",
          "duration_sec": 4.754286,
