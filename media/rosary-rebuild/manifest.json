          "true_peak_dbtp": -2.55,
          "sha256": "fb409a4f91d6c311efd90e7b380c1b39f940e5e5bf95653638a1faa85c541100",
          "script": "Picture Mary freely preparing to say yes to God.",
          "script_sha256": "525ca510fd76ae503e083fa9f3dc15eb1bc446890914a2fa5cc8a9426769fe74"
        },
        "step-10": {
          "path": "/media/rosary-rebuild/joyful_1/step-10.mp3",
          "clip_title": "Visualization 8",
          "duration_sec": 4.884898,
