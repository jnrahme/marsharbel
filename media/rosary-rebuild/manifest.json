          "true_peak_dbtp": -2.13,
          "sha256": "b334f3c29719eab3832298c65ae5b2e58fa4c2999dcc007c57157865a7f87be5",
          "script": "Picture the Son of God becoming a child in Mary's womb.",
          "script_sha256": "3378f275ddcf5a4de03d346d812b985f150a15271ac3b30677642f7a70b4b803"
        },
        "step-12": {
          "path": "/media/rosary-rebuild/joyful_1/step-12.mp3",
