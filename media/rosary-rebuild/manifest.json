          "sha256": "238fa09821c2c63bfb03d66788056f700098284a13592d1f9e1cce87a674ce6e",
          "script": "Ask Christ for humility and surrender to God.\n\nPicture the Holy Spirit overshadowing Mary.",
          "script_sha256": "f37830ada02969029ad9146d2dcfd83a572fd19da18e711c5706ca0986020edb"
        },
        "step-09": {
