          "sha256": "c80b19aedfdba254c2e591e8f51c1d17c289fa7199dd4a7cadff59082a17ecfc",
          "script": "Picture Mary remaining in the quiet room after the angel leaves.",
          "script_sha256": "58917a8a1134a5165853ddb295dcaad05f9e1853654beadcbce16f4acba6c510"
        },
        "step-13": {
          "path": "/media/rosary-rebuild/joyful_1/step-13.mp3",
          "clip_title": "Closing petition and prayers",
