{
  "name": "marcharbel",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "test": "npm run test:rosary-smoke",
    "test:rosary-smoke": "scripts/tests/run_rosary_smoke.sh",
    "test:rosary-menu": "scripts/tests/run_rosary_menu_behaviors.sh",
    "test:rosary-ui-regression": "scripts/tests/run_rosary_ui_regression.sh",
    "test:story-floating-player": "scripts/tests/run_story_floating_player.sh",
    "test:checklist": "scripts/tests/run_checklist_improvements.sh",
    "test:rosary-all": "npm run test:rosary-smoke && npm run test:rosary-menu && npm run test:rosary-end-rules && npm run test:rosary-prayer-behavior && npm run test:rosary-intro-cta && npm run test:rosary-ui-regression && npm run test:story-floating-player && npm run test:checklist",
    "test:site-smoke": "scripts/tests/run_site_smoke.sh",
    "test:layout": "node scripts/tests/layout_audit.mjs",
    "test:ui-behavior": "node scripts/tests/navigation_gallery.mjs",
    "test:qa-all": "npm run test:site-smoke && npm run test:rosary-all",
    "test:rosary-end-rules": "scripts/tests/run_rosary_end_stage_rules.sh",
    "test:rosary-prayer-behavior": "scripts/tests/run_rosary_prayer_behavior.sh",
    "test:rosary-intro-cta": "scripts/tests/run_rosary_intro_cta_behavior.sh",
    "qa": "scripts/qa/run_full_qa.sh",
    "qa:static": "scripts/qa/prepush.sh",
    "qa:all": "scripts/qa/prepush.sh && scripts/qa/run_full_qa.sh --ci && npm run quality",
    "hooks:install": "git config core.hooksPath .githooks",
    "qa:ci": "scripts/qa/run_full_qa.sh --ci",
    "qa:agentic:smoke": "scripts/qa/agentic_smoke.sh",
    "qa:dead-code": "scripts/qa/dead_code_check.sh",
    "quality:e2e": "playwright test --config playwright.config.cjs",
    "test:a11y": "playwright test --config playwright.config.cjs tests/accessibility-gate.spec.js --project=phone --project=laptop",
    "quality": "npm run quality:e2e",
    "books:api": "node scripts/books/build-api.mjs",
    "books:pages": "node scripts/books/pages.mjs build",
    "books:check": "node scripts/books/build-api.mjs --check && node scripts/books/verify-roundtrip.mjs && node scripts/books/pages.mjs --check",
    "build:home-css": "node scripts/build-home-css.mjs",
    "test:testimony-security": "node scripts/tests/testimony_database.mjs && node --import tsx scripts/tests/testimony_validation.mts && node scripts/tests/testimony_edge.mjs && node --import tsx scripts/tests/intake_rate_limit.mts && node scripts/tests/intake_rate_database.mjs && node scripts/tests/testimony_xss.mjs",
    "test:testimony-ui": "node scripts/tests/testimony_ui.mjs",
    "build:navigation": "node scripts/sync-navigation.mjs",
    "test:navigation-sync": "node scripts/sync-navigation.mjs --check",
    "i18n:build": "python3 scripts/build-international.py",
    "i18n:check": "python3 scripts/build-international.py --check && python3 scripts/qa/check_i18n_policy.py",
    "i18n:test": "python3 -m unittest discover -s scripts/qa -p \"test_i18n.py\"",
    "build:pages": "node scripts/build-pages.mjs",
    "test:pages-sync": "node scripts/build-pages.mjs --check",
    "qa:compare-served": "scripts/qa/compare-served.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.58.2",
    "acorn": "8.15.0",
    "esbuild": "0.25.12",
    "playwright": "^1.58.2",
    "purgecss": "7.0.2",
    "tsx": "^4.23.15"
  }
}
