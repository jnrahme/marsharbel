-<div aria-hidden="true" class="storybook-illustration" id="story-illustration"><div class="scene-art scene-legacy"><img alt="" class="scene-photo" decoding="async" fetchpriority="high" src="/media/mysteries/l4.webp"/><div aria-hidden="true" class="scene-photo-overlay"></div></div></div>
