    {
      "id": "bk-magdalene-p01",
      "index": 1,
      "kind": "story",
      "scene": "birth",
      "access": "public",
      "image": "bk-magdalene-img-01",
      "audio": {
        "en": "bk-magdalene-aud-en-01"
      },
      "evidence": [
        {
          "type": "documented",
          "claim": "Luke 8:1-3 names Mary among the women who accompanied and supported Jesus; Vatican News explains Magdala. The lake scene is imaginative.",
          "sources": [
            "magdaleneLuke8",
            "magdaleneVaticanNews"
          ]
        }
      ]
    },
    {
      "id": "bk-magdalene-p02",
      "index": 2,
      "kind": "story",
      "scene": "birth",
      "access": "public",
      "image": "bk-magdalene-img-02",
      "audio": {
        "en": "bk-magdalene-aud-en-02"
      },
      "evidence": [
        {
          "type": "documented",
          "claim": "Luke 8:1-3 describes Jesus traveling through towns and villages with the Twelve and women including Mary. Meals and dialogue are devotional scene-setting.",
          "sources": [
            "magdaleneLuke8"
          ]
        }
      ]
    },
    {
      "id": "bk-magdalene-p03",
      "index": 3,
      "kind": "story",
      "scene": "birth",
      "access": "public",
      "image": "bk-magdalene-img-03",
      "audio": {
        "en": "bk-magdalene-aud-en-03"
      },
      "evidence": [
        {
          "type": "documented",
          "claim": "John 19:25 names Mary Magdalene beside the cross. The caregiver invitation is a present-day pastoral reflection.",
          "sources": [
            "magdaleneJohn19"
          ]
        }
      ]
    },
    {
      "id": "bk-magdalene-p04",
      "index": 4,
      "kind": "story",
      "scene": "birth",
      "access": "public",
      "image": "bk-magdalene-img-04",
      "audio": {
        "en": "bk-magdalene-aud-en-04"
      },
      "evidence": [
        {
          "type": "documented",
          "claim": "Matthew 27:59-61 describes the burial and stone; John 20:1-2 describes Mary arriving while dark, finding the stone moved, and telling the disciples.",
          "sources": [
            "magdaleneMatthew27",
            "magdaleneJohn20"
          ]
        }
      ]
    },
    {
      "id": "bk-magdalene-p05",
      "index": 5,
      "kind": "story",
      "scene": "birth",
      "access": "public",
      "image": "bk-magdalene-img-05",
      "audio": {
        "en": "bk-magdalene-aud-en-05"
      },
      "evidence": [
        {
          "type": "documented",
          "claim": "John 20:3-15 describes the disciples at the tomb, Mary weeping, the angels, and her mistake about the gardener.",
          "sources": [
            "magdaleneJohn20"
          ]
        }
      ]
    },
    {
      "id": "bk-magdalene-p06",
      "index": 6,
      "kind": "story",
      "scene": "birth",
      "access": "public",
      "image": "bk-magdalene-img-06",
      "audio": {
        "en": "bk-magdalene-aud-en-06"
      },
      "evidence": [
        {
          "type": "documented",
          "claim": "John 20:15-16 describes Jesus calling Mary by name and her reply, Rabbouni.",
          "sources": [
            "magdaleneJohn20"
          ]
        }
      ]
    },
    {
      "id": "bk-magdalene-p07",
      "index": 7,
      "kind": "story",
      "scene": "birth",
      "access": "public",
      "image": "bk-magdalene-img-07",
      "audio": {
        "en": "bk-magdalene-aud-en-07"
      },
      "evidence": [
        {
          "type": "documented",
          "claim": "John 20:17-18 records the message Jesus gave Mary and her announcement to the disciples.",
          "sources": [
            "magdaleneJohn20"
          ]
        }
      ]
    },
    {
      "id": "bk-magdalene-p08",
      "index": 8,
      "kind": "story",
      "scene": "birth",
      "access": "public",
      "image": "bk-magdalene-img-08",
      "audio": {
        "en": "bk-magdalene-aud-en-08"
      },
      "evidence": [
        {
          "type": "documented",
          "claim": "The Holy See explains the title apostle of the apostles and the July 22 feast. The ancient scene is a retrospective remembrance, not Mary living in a later century.",
          "sources": [
            "magdaleneChurch2016",
            "magdaleneVaticanNews"
          ]
        }
      ]
    },
    {
      "id": "bk-magdalene-p09",
      "index": 9,
      "kind": "story",
      "scene": "birth",
      "access": "public",
      "image": "bk-magdalene-img-09",
      "audio": {
        "en": "bk-magdalene-aud-en-09"
      },
      "evidence": [
        {
          "type": "documented",
          "claim": "John 20:18 records Mary announcing that she had seen the Lord. The illustration is an imaginative remembrance of her witness.",
          "sources": [
            "magdaleneJohn20"
          ]
        }
      ]
    },
    {
      "id": "bk-magdalene-p10",
      "index": 10,
      "kind": "reflection",
      "scene": "birth",
      "access": "public",
      "image": "bk-magdalene-img-10",
      "audio": {
        "en": "bk-magdalene-aud-en-10"
      },
      "evidence": [
        {
          "type": "devotional",
          "claim": "Present-day family reflection and an original prayer, inviting a caregiver-assisted reading of John 20:11-18. The modern family is not a historical scene.",
          "sources": [
            "magdaleneJohn20"
          ]
        }
      ]
    }
