DirectoryIndex index.html

# Local error document preserves the 404 status and applies app headers.
# Absolute site-relative path also works beneath missing locale/deep URLs.
ErrorDocument 404 /404.html

AddType application/manifest+json .webmanifest
AddType image/avif .avif

RewriteEngine On

# Deployment contains source and test files; these are never public endpoints.
RewriteRule ^(?:\.git|\.github|supabase|scripts|tests|personal-docs|docs|content|templates|node_modules|output|tmp|test-results)(?:/|$) - [F,L]
<FilesMatch "(?i)(^\.env(?:\..*)?$|\.(?:sql|toml)$|^turnstile-secret\.php(?:\..*)?$)">
  Require all denied
</FilesMatch>

# Consolidate the known public alias; leave staging/local hosts untouched.
RewriteCond %{HTTP_HOST} ^www\.marsharbel\.com$ [NC]
RewriteRule ^ https://marsharbel.com%{REQUEST_URI} [R=301,L]

# Consolidate explicit homepage requests without redirecting internal rewrites.
RewriteCond %{THE_REQUEST} \s/+index(?:\.html)?(?:[\s?]|$) [NC]
RewriteRule ^index(?:\.html)?$ / [R=301,L]

# Recover the misplaced Rosary paths reported by Search Console.
# The real Rosary page lives at the root.
# Keep language query parameters and redirect before the generic .html rule.
RewriteRule ^(?:mysteries|miracles(?:/eucharistic)?)/rosary-visual-guide(?:\.html)?/?$ /rosary-visual-guide [R=301,L]

# Recover the legacy Rosary and 22nd-of-the-month URLs that Google still
# reports. The generic ".html" redirect below would otherwise send them
# to clean URLs that do not exist.
RewriteRule ^rosary(?:\.html)?/?$ /rosary-visual-guide [R=301,L]
RewriteRule ^the-22nd-of-the-month(?:\.html)?/?$ /22nd-of-the-month [R=301,L]

# Reviewed full prayer masters must remain served at their declared identities.
# /en/prayers canonical adoption requires a separate head-cluster migration.

# Language hubs are directory indexes with canonical trailing slashes.
# i18n-routes:start
RewriteRule ^en/?$ / [R=301,L]
RewriteRule ^(ar|fr|es|pt|it|de|pl|ru|hi|th)/index(?:\.html)?$ /$1/ [R=301,L]
RewriteRule ^(ar|fr|es|pt|it|de|pl|ru|hi|th)\.html$ /$1/ [R=301,L]
RewriteRule ^(ar|fr|es|pt|it|de|pl|ru|hi|th)$ /$1/ [R=301,L]
# i18n-routes:end

# The miracles hub is a directory index; /miracles/index(.html) must not serve a duplicate page.
RewriteRule ^miracles/index(?:\.html)?$ /miracles/ [R=301,L]

# English-prefix aliases: existing authored /en guides stay in place.
RewriteCond %{DOCUMENT_ROOT}/en/$1.html !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^en/([a-z0-9-]+)(?:\.html)?/?$ /$1 [R=301,L]

# Search Console HTML-file verification files must serve directly (a redirect
# breaks verification).
RewriteRule ^google[^/]*\.html$ - [L]

# Redirect direct ".html" requests to clean URLs.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[\s?]|$) [NC]
RewriteRule ^ /%1 [R=301,L]

# Resolve /gallery to gallery.html even though /gallery is a real assets directory.
RewriteRule ^gallery/?$ gallery.html [L]

# Canonicalize non-root URLs to no trailing slash (prevents duplicate content).
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} .+/$
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Internally map clean URLs to existing ".html" files.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Revalidate documents and code after every deployment. Static media keeps the
# hosting provider's long-lived cache policy.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:html|css|js|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <Files "service-worker.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
</IfModule>

# Production security baseline (Hostinger/LiteSpeed honors mod_headers).
# Keep the dependency-heavy CSP in report-only until browser review is complete.
# Report-only violations are visible in DevTools; no telemetry endpoint is set.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  Header always set Content-Security-Policy "upgrade-insecure-requests; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://cdn.jsdelivr.net https://challenges.cloudflare.com https://js.hcaptcha.com https://*.hcaptcha.com https://cdn.shopify.com 'sha256-XUc8JiXD7MgiRdkm/qC5alVSnfZ5mjS6fyZsSFAPO+A=' 'sha256-udIr1mfCcek64YOssSH6ob3Xg5kCEWTh040pvRe/3yc=' 'sha256-nl2DCuO/6Knr/qaRn2lfhiAbou0I1Ayclrm/nb2np7k=' 'sha256-9WQsezAJngPQP5h0wdVGNnbpTxfjAqvawluEBxT2qAs=' 'sha256-mfd+xUhZU0KOHCh0XHQhaBxum2H/p6kg0hv4piDUZwc=' 'sha256-oCLbR4GLhIWheA1H+8Wsp5N0QWuJBqv+OMGSqQuxRy8=' 'sha256-WQxY48R937cgyWJ92u11hw5zvCyPTTu03e7RYjU9yLg=' 'sha256-NLw/b0iL6+v7ABXVPkhNWWJ8Vhoi5fcBuIX+jNLZFI4=' 'sha256-wxvFqjoVYiomQaaHwQ6kinYU0fui5XbmYRykKGbMPmU=' 'sha256-ZOvhwlRU3Qhb6FB8PPmg/miGdDucY9lDmHZDOsnMSgs='; style-src 'self' 'unsafe-inline' https://*.hcaptcha.com; img-src 'self' data: blob: https:; font-src 'self' data: https://*.hcaptcha.com; connect-src 'self' https://alxccoizzksyitxvqhpv.supabase.co wss://alxccoizzksyitxvqhpv.supabase.co https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://translate.googleapis.com https://challenges.cloudflare.com https://*.hcaptcha.com https://*.myshopify.com https://*.shopify.com; frame-src https://www.youtube-nocookie.com https://challenges.cloudflare.com https://*.hcaptcha.com; media-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
  # One-year HSTS, host-only. No includeSubDomains/preload: ftp.marsharbel.com resolves but has no HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  <FilesMatch "^(?:account|submit-testimony|testimony-review|feedback|feedback-review|daily-prayer|daily-prayer-admin)\.html$">
    Header unset Cache-Control
    Header always set Cache-Control "no-store, max-age=0"
  </FilesMatch>
  <Files "404.html">
    Header unset Cache-Control
    Header always set Cache-Control "no-store, max-age=0"
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </Files>
  <Files "testimony-review.html">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set Referrer-Policy "no-referrer"
  </Files>
  <Files "feedback.html">
    Header always set X-Robots-Tag "noindex, follow"
  </Files>
  <Files "feedback-review.html">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set Referrer-Policy "no-referrer"
  </Files>
  <Files "daily-prayer-admin.html">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set Referrer-Policy "no-referrer"
  </Files>
</IfModule>
