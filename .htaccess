DirectoryIndex index.html

# Local error document preserves the 404 status and applies app headers.
# Absolute site-relative path also works beneath missing locale/deep URLs.
ErrorDocument 404 /404.html

AddType application/manifest+json .webmanifest
AddType image/avif .avif

RewriteEngine On

# Deployment contains source and test files; these are never public endpoints.
RewriteRule ^(?:\.git|\.github|supabase|scripts|tests|personal-docs|docs|node_modules|output|tmp|test-results)(?:/|$) - [F,L]
<FilesMatch "(?i)(^\.env(?:\..*)?$|\.(?:sql|toml)$|^turnstile-secret\.php(?:\..*)?$)">
  Require all denied
</FilesMatch>

# Consolidate the known public alias; leave staging/local hosts untouched.
RewriteCond %{HTTP_HOST} ^www\.marsharbel\.com$ [NC]
RewriteRule ^ https://marsharbel.com%{REQUEST_URI} [R=301,L]

# Consolidate explicit homepage requests without redirecting internal rewrites.
RewriteCond %{THE_REQUEST} \s/+index(?:\.html)?(?:[\s?]|$) [NC]
RewriteRule ^index(?:\.html)?$ / [R=301,L]

# Recover the old misplaced Rosary links reported by Search Console. Keep the
# language query parameter so visitors retain their selected translation.
RewriteRule ^mysteries/rosary-visual-guide(?:\.html)?/?$ /rosary-visual-guide [R=301,L]

# Recover the legacy Rosary and 22nd-of-the-month URLs that Google still
# reports. The generic ".html" redirect below would otherwise send them
# to clean URLs that do not exist.
RewriteRule ^rosary(?:\.html)?/?$ /rosary-visual-guide [R=301,L]
RewriteRule ^the-22nd-of-the-month(?:\.html)?/?$ /22nd-of-the-month [R=301,L]

# Retire the duplicate English prayer master: its body duplicates the
# /en/prayers guide, which is the cluster's canonical English URL.
RewriteRule ^saint-charbel-prayers(?:\.html)?/?$ /en/prayers [R=301,L]

# Language hubs are directory indexes with canonical trailing slashes.
# i18n-routes:start
RewriteRule ^en/?$ / [R=301,L]
RewriteRule ^(ar|fr|es|pt|it|de|pl)/index(?:\.html)?$ /$1/ [R=301,L]
RewriteRule ^(ar|fr|es|pt|it|de|pl)\.html$ /$1/ [R=301,L]
RewriteRule ^(ar|fr|es|pt|it|de|pl)$ /$1/ [R=301,L]
# i18n-routes:end

# English-prefix aliases: existing authored /en guides stay in place.
RewriteCond %{DOCUMENT_ROOT}/en/$1.html !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^en/([a-z0-9-]+)(?:\.html)?/?$ /$1 [R=301,L]

# Search Console HTML-file verification files must serve directly (a redirect
# breaks verification).
RewriteRule ^google[^/]*\.html$ - [L]

# Redirect direct ".html" requests to clean URLs.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[\s?]|$) [NC]
RewriteRule ^ /%1 [R=301,L]

# Resolve /gallery to gallery.html even though /gallery is a real assets directory.
RewriteRule ^gallery/?$ gallery.html [L]

# Canonicalize non-root URLs to no trailing slash (prevents duplicate content).
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} .+/$
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Internally map clean URLs to existing ".html" files.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Revalidate documents and code after every deployment. Static media keeps the
# hosting provider's long-lived cache policy.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:html|css|js|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <Files "service-worker.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
</IfModule>

# Production security baseline (Hostinger/LiteSpeed honors mod_headers).
# Keep the dependency-heavy CSP in report-only until browser review is complete.
# Report-only violations are visible in DevTools; no telemetry endpoint is set.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  Header always set Content-Security-Policy "upgrade-insecure-requests; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://cdn.jsdelivr.net https://challenges.cloudflare.com https://js.hcaptcha.com https://*.hcaptcha.com https://cdn.shopify.com; style-src 'self' 'unsafe-inline' https://*.hcaptcha.com; img-src 'self' data: blob: https:; font-src 'self' data: https://*.hcaptcha.com; connect-src 'self' https://alxccoizzksyitxvqhpv.supabase.co wss://alxccoizzksyitxvqhpv.supabase.co https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://translate.googleapis.com https://challenges.cloudflare.com https://*.hcaptcha.com https://*.myshopify.com https://*.shopify.com; frame-src https://www.youtube-nocookie.com https://challenges.cloudflare.com https://*.hcaptcha.com; media-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
  # One-year HSTS, host-only. No includeSubDomains/preload: ftp.marsharbel.com resolves but has no HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  <FilesMatch "^(?:account|submit-testimony|testimony-review)\.html$">
    Header unset Cache-Control
    Header always set Cache-Control "no-store, max-age=0"
  </FilesMatch>
  <Files "404.html">
    Header unset Cache-Control
    Header always set Cache-Control "no-store, max-age=0"
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </Files>
  <Files "testimony-review.html">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set Referrer-Policy "no-referrer"
  </Files>
</IfModule>
