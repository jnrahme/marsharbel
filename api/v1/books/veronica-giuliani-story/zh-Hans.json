   ]
  },
  {
   "id": "bk-veronica-giuliani-p02",
   "index": 2,
   "kind": "story",
   "scene": "vocation",
   "access": "public",
   "title": "愿望在皮亚琴察生长",
   "body": "奥尔索拉七岁时，妈妈去世了。爸爸在一座叫皮亚琴察的城市找到了新工作，全家随他搬到了那里。一个古老的故事说，奥尔索拉还是个小女孩时，就把自己的食物分给穷孩子们。在皮亚琴察，她开始感觉到心里有一样东西在生长：一个愿望，把自己的一生完全献给耶稣。",
   "prayer": null,
   "heart": null,
   "image": "bk-veronica-giuliani-img-02",
   "imageAlt": null,
   "audio": null,
   "evidence": [
