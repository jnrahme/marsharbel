     ]
    }
   ]
  },
  {
   "id": "bk-veronica-giuliani-p05",
   "index": 5,
   "kind": "story",
   "scene": "vocation",
   "access": "public",
   "title": "她留下了",
   "body": "最初的几年并不容易。有时韦罗尼加也受到诱惑，想放弃一切，回到外面的世界。她留下了。一年后，1678年，她站在修女们面前，许下庄严的誓愿：把一生献给天主。她是打算信守这个誓愿的。",
   "prayer": null,
   "heart": null,
   "image": "bk-veronica-giuliani-img-05",
   "imageAlt": null,
   "audio": null,
   "evidence": [
    {
