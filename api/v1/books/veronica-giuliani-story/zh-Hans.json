     ]
    }
   ]
  },
  {
   "id": "bk-veronica-giuliani-p03",
   "index": 3,
   "kind": "story",
   "scene": "vocation",
   "access": "public",
   "title": "父亲另外的打算",
   "body": "这样的愿望要追随并不容易。奥尔索拉的父亲对她另有打算。他想让她出嫁，还找来希望做她丈夫的年轻人。但奥尔索拉的心牵挂着另一个家：修道院，在那里修女们生活简朴、一起祈祷。她等待着。她怀着希望。终于，父亲答应了。",
   "prayer": null,
   "heart": null,
   "image": "bk-veronica-giuliani-img-03",
   "imageAlt": null,
   "audio": null,
   "evidence": [
    {
     "type": "documented",
