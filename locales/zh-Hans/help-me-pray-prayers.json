{
  "artifact": "483e11f2f9679b056f364463b11e5697baa5671627a6673c5477725fe964cf2e",
  "rows": [
    {
      "prayer": "our-father",
      "text": "我们的天父，愿祢的名受显扬；愿祢的国来临；愿祢的旨意奉行在人间，如同在天上。求祢今天赏给我们日用的食粮；求祢宽恕我们的罪过，如同我们宽恕别人一样；不要让我们陷于诱惑；但救我们免于凶恶。",
      "textSha256": "46ef25a554b9b001a8dc5bdc7f133acec7916771c6e081e39380381f4675b491",
      "status": "active-standard",
      "rowRef": "zh-Hans:our-father"
    },
    {
      "prayer": "glory-be",
      "text": "愿光荣归于父、及子、及圣神；起初如何，今日亦然，直到永远。阿们。",
      "textSha256": "0e453026a449d4e767d6a80e65e92d9a387a22dc9cb82c4f45e8e49916f1f9f8",
      "status": "active-standard",
      "rowRef": "zh-Hans:glory-be"
    }
  ]
}
