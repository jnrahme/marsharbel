    {
      "scriptOrdinal": 1,
      "jsonPointer": "/mainEntity/0/name",
      "source": "Is there an entrance fee at Annaya?",
      "catalog": "pilgrimage-master-copy.json",
      "key": "pilgrimage.frequently-asked-questio.is-there-an-entrance-fee-at-annaya",
      "translation": "进入安纳亚需要门票吗？"
    },
    {
      "scriptOrdinal": 1,
      "jsonPointer": "/mainEntity/0/acceptedAnswer/text",
      "source": "The monastery, the tomb, and the hermitage are open to everyone, of any faith or none. Check with the monastery before you travel for any current charges or opening times.",
      "catalog": "pilgrimage-master-copy.json",
      "key": "pilgrimage.frequently-asked-questio.the-monastery-the-tomb-and-the-hermitage-are-open-to-everyon",
      "translation": "修道院、圣人墓与隐修院向所有人开放，无论信仰为何，或是否有宗教信仰。出发前请向修道院确认目前是否收费及开放时间。"
    },
    {
      "scriptOrdinal": 1,
      "jsonPointer": "/mainEntity/1/name",
      "source": "How many days do I need?",
      "catalog": "pilgrimage-master-copy.json",
      "key": "pilgrimage.frequently-asked-questio.how-many-days-do-i-need",
      "translation": "需要安排几天？"
    },
    {
      "scriptOrdinal": 1,
      "jsonPointer": "/mainEntity/1/acceptedAnswer/text",
      "source": "One full day covers Annaya and Byblos. Three days lets you add Bekaa Kafra and the Qadisha Valley without rushing.",
      "catalog": "pilgrimage-master-copy.json",
      "key": "pilgrimage.frequently-asked-questio.one-full-day-covers-annaya-and-byblos-three-days-lets-you-ad",
      "translation": "完整的一天可探访安纳亚与比布鲁斯。安排三天，便可从容加入贝卡卡夫拉与卡迪沙谷。"
    },
    {
      "scriptOrdinal": 1,
      "jsonPointer": "/mainEntity/2/name",
      "source": "What is the best season?",
      "catalog": "pilgrimage-master-copy.json",
      "key": "pilgrimage.frequently-asked-questio.what-is-the-best-season",
      "translation": "哪个季节最适合前往？"
    },
    {
      "scriptOrdinal": 1,
      "jsonPointer": "/mainEntity/2/acceptedAnswer/text",
      "source": "Spring through autumn for the mountain sites - winter snow can close the roads to Bekaa Kafra and the Cedars. Check with the monastery for current opening times.",
      "catalog": "pilgrimage-master-copy.json",
      "key": "pilgrimage.frequently-asked-questio.spring-through-autumn-for-the-mountain-sites-winter-snow-can",
      "translation": "山区圣地适合在春季至秋季探访。冬季积雪可能使通往贝卡卡夫拉与香柏林的道路关闭。请向修道院确认最新开放时间。"
    },
    {
      "scriptOrdinal": 1,
      "jsonPointer": "/mainEntity/3/name",
      "source": "Can I attend Mass at Annaya?",
      "catalog": "pilgrimage-master-copy.json",
      "key": "pilgrimage.frequently-asked-questio.can-i-attend-mass-at-annaya",
      "translation": "可以在安纳亚参与弥撒吗？"
    },
    {
      "scriptOrdinal": 1,
      "jsonPointer": "/mainEntity/4/name",
      "source": "Is it safe to travel to Lebanon?",
      "catalog": "pilgrimage-master-copy.json",
      "key": "pilgrimage.frequently-asked-questio.is-it-safe-to-travel-to-lebanon",
      "translation": "前往黎巴嫩安全吗？"
    },
    {
      "scriptOrdinal": 1,
      "jsonPointer": "/mainEntity/4/acceptedAnswer/text",
      "source": "Conditions change - check your government's current travel advice before booking, and take local advice on routes once you arrive. The pilgrimage sites themselves normally receive visitors; check before you go.",
      "catalog": "pilgrimage-master-copy.json",
      "key": "pilgrimage.frequently-asked-questio.conditions-change-check-your-government-s-current-travel-adv",
      "translation": "情况会变化。预订前请查看本国政府最新的旅行建议，抵达后也应听取当地人对路线的建议。这些朝圣地点本身通常接待访客，但出发前仍应确认。"
    }
  ],
